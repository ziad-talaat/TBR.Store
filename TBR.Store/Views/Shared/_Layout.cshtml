<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TBR.Store</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TBR.Store.styles.css" asp-append-version="true" />

   
</head>

<body>

    <nav class="tbr-nav">
        <div class="container-fluid">

            <a class="tbr-brand"  asp-area="Customer" asp-controller="Home" asp-action="AboutUs">TBR.Store</a>

            <button class="tbr-toggler" id="navToggler" aria-label="Toggle navigation">
                <i class="bi bi-list fs-5"></i>
            </button>

            <div class="tbr-links" id="navLinks">

                <a class="tbr-nav-link" asp-area="Customer" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house me-1"></i>Home
                </a>

                @if (User.Identity.IsAuthenticated)
                {
                    <a class="tbr-nav-link" asp-area="Admin" asp-controller="Order" asp-action="Index">
                        <i class="bi bi-receipt me-1"></i>Manage Orders
                    </a>
                }

                @if (User.IsInRole(Roles.Role_Admin))
                {
                    <div class="tbr-dropdown">
                        <span class="tbr-nav-link tbr-dropdown-toggle">
                            <i class="bi bi-grid me-1"></i>Content
                            <i class="bi bi-chevron-down chevron"></i>
                        </span>
                        <div class="tbr-dropdown-menu">
                            <a class="tbr-dropdown-item" asp-area="Admin" asp-controller="Category" asp-action="Index">
                                <i class="bi bi-tag me-2"></i>Categories
                            </a>
                            <a class="tbr-dropdown-item" asp-area="Admin" asp-controller="Product" asp-action="Index">
                                <i class="bi bi-book me-2"></i>Products
                            </a>
                            <a class="tbr-dropdown-item" asp-area="Admin" asp-controller="Company" asp-action="Index">
                                <i class="bi bi-building me-2"></i>Companies
                            </a>
                            <div class="tbr-dropdown-divider"></div>
                            <a class="tbr-dropdown-item" asp-area="Customer" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus me-2"></i>Create User
                            </a>
                            <a class="tbr-dropdown-item" asp-area="Admin" asp-controller="User" asp-action="Index">
                                <i class="bi bi-people me-2"></i>Manage Users
                            </a>
                        </div>
                    </div>
                }

                @if (User.Identity.IsAuthenticated)
                {
                    <a class="tbr-cart-btn"
                      
                       asp-area="Customer" asp-controller="Cart" asp-action="Index">
                        <i class="bi bi-cart3"></i>
                        <span>Cart</span>
                        <span class="tbr-cart-badge">@await Component.InvokeAsync("Cart")</span>
                    </a>
                }

            </div>
            <div class="tbr-auth">
                <partial name="_loginPartial" />
            </div>

        </div>
    </nav>
    <div class="tbr-main-wrap">
        <div class="container">
            <main role="main" class="pb-3">
                <partial name="_Notifications" />
                @RenderBody()
            </main>
        </div>
    </div>
    <footer class="tbr-footer">
        <div class="tbr-footer-brand">TBR.Store</div>
        <div class="tbr-footer-sub">
            Made with <span class="heart">♥</span> by Zeyad Talaat
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
        const toggler = document.getElementById('navToggler');
        const navLinks = document.getElementById('navLinks');
        toggler?.addEventListener('click', () => {
            navLinks.classList.toggle('open');
        });

        document.addEventListener('click', e => {
            if (!toggler?.contains(e.target) && !navLinks?.contains(e.target)) {
                navLinks?.classList.remove('open');
            }
        });

        document.querySelectorAll('.tbr-dropdown').forEach(dd => {
            dd.addEventListener('keydown', e => {
                if (e.key === 'Enter' || e.key === ' ') dd.classList.toggle('open');
                if (e.key === 'Escape') dd.classList.remove('open');
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
