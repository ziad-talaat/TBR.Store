

@model ChangePasswordVM
@{
    ViewData["Title"] = "Change Password";
}

<h2 class="mb-3">Change Password</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["success"] != null)
{
    <div class="alert alert-success">@TempData["success"]</div>
}

<form asp-action="ChangePassword" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="@Model.OldPassword"></label>
        <input asp-for="@Model.OldPassword" class="form-control" />
        <span asp-validation-for="@Model.OldPassword" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <label asp-for="@Model.NewPassword"></label>
        <input type="password" asp-for="@Model.NewPassword" class="form-control" />
        <span asp-validation-for="@Model.NewPassword" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <label asp-for="@Model.ConfirmPassord"></label>
        <input type="password"  asp-for="@Model.ConfirmPassord" class="form-control" />
        <span asp-validation-for="@Model.ConfirmPassord" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Change Password</button>
</form>
