
 @model Pagination<Product>

@{

    ViewData["Title"] = "Products";
    var currentSortBy = ViewBag.CurrentSortBy as string ?? "";
    var currentOrder = (bool)(ViewBag.CurrentOrder ?? true);
    var currentSearchValue = ViewBag.CurrentSearchValue as string ?? "";
    var currentCategory = ViewBag.CurrentCategory as string ?? "";
    var CurrentPage = (int)(ViewBag.CurrentPage??1);
    var categories = ViewBag.FilterCategories as List<SelectListItem> ?? new List<SelectListItem>();
}

<div class="row">
    <div class="col-md-2">
        <form id="sortForm" asp-action="Index" method="get" class="border p-2 rounded bg-light">
            <div class="form-group mb-2">
                <select  class="form-select form-select-sm" name="sortBy">
                    <option value="">-- SortBy --</option>
                    <option value="Price" selected="@(currentSortBy == "Price")">Price</option>
                    <option value="TopRated" selected="@(currentSortBy == "TopRated")">Top Rated</option> 
                </select>
            </div>

            <div id="radioBox" class="form-group mb-2">
                <label class="form-label small">Order</label><br />
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="isAssending" value="true" @(currentOrder ? "checked" : "") />
                    <label class="form-check-label small">Asc</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="isAssending" value="false" @(!currentOrder ? "checked" : "") />
                    <label class="form-check-label small">Desc</label>
                </div>
            </div>

            <div class="categoriesContainer form-group mb-2">
                <label class="form-label small">Category</label>
                @foreach (var category in categories)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="categoryValue" value="@category.Value"
                        @(currentCategory == category.Value ? "checked" : "") />
                        <label class="form-check-label small">@category.Text</label>
                    </div>
                }
            </div>

         @*   <input id="searchByInput" type="hidden" name="searchBy" value="@currentSearchBy" />
            <input  id="searchValueInput" type="hidden" name="searchValue" value="@currentSearchValue" />
            *@
            @* <button type="submit" class="btn btn-sm btn-primary w-100">Apply</button>*@
        </form>
    </div>

    <div class="col-md-10">
        <form id="searchForm" asp-action="Index" method="get" class="form-control mb-3 p-3">
            <div style="position:relative" class="row flex-column g-2">
                <div style="position:relative" class="col-md-5 offset-md-3">
                    <input type="search" name="searchValue" class="form-control form-control-sm" placeholder="Search By product Name..." value="@currentSearchValue" />
                    
                        <svg id="icone" class="item-icon-big" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                   
                </div>
                <div class="col-md-5 offset-md-3" style="position:absolute;top: 100%;  
        left: 0;
        right: 0;z-index:2;border: 1px solid #dee2e6; border-radius: 8px ;height:fit-content;background-color:#f3f4f6">
   
                    <ul class="autocomplete-list">
                        
                    </ul>
                </div>
            </div>
        </form>

        <div id="productContainer" class="row pb-3">
            @foreach (var product in Model.Items)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 d-flex mb-4">
                    <div class="card border-0 p-3 shadow border-top border-5 rounded w-100 h-100 d-flex flex-column">
                        @if (product.ProductImages.Count()>0)
                        {
                            <img src="@product.ProductImages.FirstOrDefault()?.ImageIrl" class="card-img-top rounded" style="height:250px;object-fit:cover;" />
                        }
                        else
                        {
                            <img src="https://placehold.co/500x600/png" class="card-img-top rounded" style="height:250px;object-fit:cover;" />
                        }

                        <div class="card-body pb-0 flex-grow-1 d-flex flex-column">
                            <div class="flex-grow-1 text-center">
                                <p class="h6 text-dark opacity-75 text-uppercase">@product.Title</p>
                                <p class="text-warning">by <strong>@product.Author</strong></p>
                                <p class="text-dark text-opacity-75 mb-0">
                                    <small>List: <span class="text-decoration-line-through">@product.DisplayPrice:c</span></small>
                                </p>
                                <p class="text-dark text-opacity-75">
                                    <small>As low as: @product.Price:c</small>
                                </p>
                            </div>
                        </div>

                            @if (User.Identity.IsAuthenticated){
                        <a  asp-action="Details"
                        asp-route-id="@product.Id"
                               asp-route-searchValue="@currentSearchValue"
                               asp-route-sortBy="@currentSortBy"
                               asp-route-categoryValue="@currentCategory"
                               asp-route-isAssending="@currentOrder"
                               asp-route-pageNumber="@CurrentPage"
                               class="checkI btn btn-primary bg-gradient border-0 form-control mt-auto">Details</a>
                            }
                    </div>
                </div>
            }
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Page navigation" class="mb-5">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pageNumber="@(Model.CurrentPage - 1)"
                               asp-route-searchValue="@currentSearchValue"
                               asp-route-sortBy="@currentSortBy"
                               asp-route-isAssending="@currentOrder"
                               asp-route-categoryFilter="@currentCategory">
                                Previous
                            </a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pageNumber="@i"
                                   asp-route-searchValue="@currentSearchValue"
                                   asp-route-sortBy="@currentSortBy"
                                   asp-route-isAssending="@currentOrder"
                                   asp-route-categoryFilter="@currentCategory">
                                    @i
                                </a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pageNumber="@(Model.CurrentPage + 1)"
                               asp-route-searchValue="@currentSearchValue"
                               asp-route-sortBy="@currentSortBy"
                               asp-route-isAssending="@currentOrder"
                               asp-route-categoryFilter="@currentCategory">
                                Next
                            </a>
                        </li>
                    </ul>
                </nav>
            }

        </div>

      </div>
</div>

@section Scripts {
    <script>
        const categoriesContainer = document.querySelector('.categoriesContainer');
         const ulList = document.querySelector('.autocomplete-list');
          const sortByList = document.querySelector('select[name="sortBy"]');
           const searchInput = document.querySelector('input[name="searchValue"]');
            const radio = document.querySelector('#radioBox');
           // const radio = document.querySelector('select[name="isAssending"]');
         
        const sortForm = document.querySelector('#sortForm');
        const searchForm = document.querySelector('#searchForm');
         const searchIcon = document.querySelector('#icone');

      
       const collectData= function(){
         const sortFormData=new FormData(sortForm);
          const searchFormData=new FormData(searchForm);

          return [...sortFormData.entries() ,...searchFormData.entries()];
        }
         const callFiltaration=function(){
              const formsData= collectData();
               const queryString = new URLSearchParams(formsData).toString();

                $.ajax({
                    url: "/Customer/Home/Index",
                   type: "GET",
                    data: queryString,
                   success: function (res) {
                       $('#productContainer').html(res);
                   },
                   error: function () {
                     toastr.error("Something went wrong");
                   }
               });
           }


          categoriesContainer.addEventListener('click',(e)=>{
               const clickedInput= e.target.closest('input');
              if(!clickedInput)return;
              callFiltaration();
          })
             sortByList.addEventListener('change',(e)=>{
                  callFiltaration();
             })

             
              radio.addEventListener('change',(e)=>{
                   const input=e.target.closest('input[name="isAssending"]')
                   if(!input)return;
                   
                    callFiltaration();
              });

            
               searchInput.addEventListener('input',(e)=>{
                     $.ajax({
                      url: "/Customer/Home/GetSearchBar",
                    type: "GET",
                     data: {
                          value:searchInput.value,
                     },
                    success: function (res) {
                          $('.autocomplete-list').html(res);
       
                    },
                    error: function () {
                      toastr.error("Something went wrong");
                    }
                });
               });


                searchIcon.addEventListener('click',()=>{
                  

                      $.ajax({
                       url: "/Customer/Home/Index",
                     type: "GET",
                      data: {
                            searchValue:searchInput.value,
                      },
                     success: function (res) {
                        
                             $('#productContainer').html(res);
                         
                     },
                     error: function () {
                       toastr.error("Something went wrong");
                     }
                 });
                });




              $(document).on('click', '.autocomplete-item', function() {
            const spanValue = $(this).find('.value').text();
            const $ulList = $('.autocomplete-list');

            $.ajax({
                url: "/Customer/Home/Index",
                type: "GET",
                data: {
                    searchValue: spanValue,
                    fromSearch: true
                },
                success: function (res) {
                    $ulList.empty();
                    $('#productContainer').html(res);
                },
                error: function () {
                    toastr.error("Something went wrong");
                }
            });
        });
    </script>
}