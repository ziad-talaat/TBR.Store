@model ShoppingCart
@{
    var sortBy = ViewBag.sortBy as string ?? "";
    var isAssending = (bool)(ViewBag.isAssending ?? true);
    var searchValue = ViewBag.searchValue as string ?? "";
    var categoryValue = ViewBag.categoryValue as string ?? "";
    var pageNumber = (int)(ViewBag.pageNumber ?? 1);


   
}
<form method="post">
    <input hidden asp-for="ProductId" />
    <div class="card shadow border-0 mt-4 mb-4">
        <div class="card-header bg-secondary bg-gradient text-light py-4">
            <div class="row">
                <div class="col-12 text-center">
                    <h3 class="text-white text-uppercase">@Model.Product.Title</h3>
                    <p class="text-white-50 fw-semibold mb-0">by @Model.Product.Author</p>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="py-3">
                <div class="row">
                    <div class="col-6 col-md-2 offset-lg-1 pb-1">
                        <a asp-action="Index"
                           asp-route-searchValue="@searchValue"
                           asp-route-sortBy="@sortBy"
                           asp-route-categoryValue="@categoryValue"
                           asp-route-isAssending="@isAssending"
                           asp-route-pageNumber="@pageNumber"
                          
                        class="btn btn-outline-primary bg-gradient mb-5 fw-semibold btn-sm text-uppercase">
                            <small>Back to home</small>
                        </a>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-lg-3 offset-lg-1 text-center mb-3">
                        @if (Model.Product.ProductImages != null && Model.Product.ProductImages.Count > 0) {
                            <div id="carouselExampleIndicators" class="carousel  slide" data-bs-ride="carousel">
                                <div class="carousel-indicators">

                                    @foreach(var imageWithIndex in 
                                    Model.Product.ProductImages
                                   .Select((image, index) => new { Image = image, Index = index })) {
                                        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="@imageWithIndex.Index" 
                                        class="@(imageWithIndex.Index==0?"active":"")" aria-current="true" aria-label="Slide 1"></button>
                                    }

                                   
                                </div>
                                <div class="carousel-inner">
                                    @foreach (var imageWithIndex in
                                   Model.Product.ProductImages
                                   .Select((image, index) => new { Image = image, Index = index })) {
                                        <div class="@(imageWithIndex.Index==0?"carousel-item active":"carousel-item")">
                                            <img src="@imageWithIndex.Image.ImageIrl" class="d-block w-100" alt="...">
                                    </div>
                                   }
                                </div>
                                <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Previous</span>
                                </button>
                                <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
                                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Next</span>
                                </button>
                            </div>
                        }

                    </div>
                    <div class="col-12 col-lg-6 offset-lg-1">

                        <div class="col-12 col-md-6 pb-4">
                            <span class="badge">@Model.Product.Category.Name</span>
                        </div>
                        <div class="row ps-2">
                            <h6 class="text-dark text-opacity-50 ">ISBN : @Model.Product.ISBN</h6>
                        </div>
                        <div class="row ps-2">
                            <h6 class="text-dark text-opacity-50  pb-2">
                                List Price:
                                <span class="text-decoration-line-through">
                                    @Model.Product.DisplayPrice.ToString("c")
                                </span>
                            </h6>
                        </div>
                        <div class="row text-center ps-2">
                            <div class="p-1 col-3 col-lg-2 bg-white border-bottom">
                                <div class="text-dark text-opacity-50 fw-semibold">Quantity</div>
                            </div>
                            <div class="p-1 col-3 col-lg-2 bg-white border-bottom">
                                <div class="text-dark text-opacity-50 fw-semibold">1-50</div>
                            </div>
                            <div class="p-1 col-3 col-lg-2 bg-white border-bottom">
                                <div class="text-dark text-opacity-50 fw-semibold">51-100</div>
                            </div>
                            <div class="p-1 col-3 col-lg-2 bg-white border-bottom">
                                <div class="text-dark text-opacity-50 fw-semibold">100+</div>
                            </div>
                        </div>
                        <div class="row text-center ps-2">
                            <div class="p-1 col-3 col-lg-2 bg-white text-warning fw-bold">
                                <div>Price</div>
                            </div>
                            <div class="p-1 col-3 col-lg-2 bg-white text-warning fw-bold">
                                <div>@Model.Product.Price.ToString("c")</div>
                            </div>
                            <div class="p-1 col-3 col-lg-2 bg-white text-warning fw-bold">
                                <div>@Model.Product.Price50.ToString("c")</div>
                            </div>
                            <div class="p-1 col-3 col-lg-2 bg-white text-warning fw-bold">
                                <div>@Model.Product.Price100.ToString("c")</div>
                            </div>
                        </div>
                        <div class="row pl-2 my-3">
                            <p class="text-secondary lh-sm">@Html.Raw(Model.Product.Describtion)</p>
                        </div>
                        <div class="row pl-2 mb-3">
                            <div class="col-md-4">
                                <div class="input-group mb-3">
                                    <span class="input-group-text bg-primary text-white border-0 fw-semibold"
                                          id="inputGroup-sizing-default">
                                        Count
                                    </span>
                                    <input asp-for="Count" type="number" value="1" class="form-control text-end"
                                           aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" />
                                </div>
                            </div>
                        </div>
                        <div class="row">


                            <div class="row mb-3">
                                <div class="col-6 col-md-3">
                                    <span id="likeCount">@await Component.InvokeAsync("UpVote", new { productId = Model.ProductId })</span>

                                    <button type="button"
                                            id="likeBtn"
                                            class="vote-btn like-btn @(ViewBag.CurrentVote == "UpVote" ? "active" : "")">
                                        <i class="bi bi-hand-thumbs-up-fill"></i> Like
                                    </button>
                                </div>

                                <div class="col-6 col-md-3">
                                    <span id="disLikeCount">@await Component.InvokeAsync("DownVote", new { productId = Model.ProductId })</span>

                                    <button type="button"
                                            id="dislikeBtn"
                                            class="vote-btn dislike-btn @(ViewBag.CurrentVote == "DownVote" ? "active" : "")">
                                        <i class="bi bi-hand-thumbs-down-fill"></i> Dislike
                                    </button>
                                </div>
                            </div>

                               
                               
                               
                           
                               
                            <div class="col-12 col-md-6 pb-1">
                                <button type="submit"
                                        class="btn btn-primary bg-gradient  w-100 py-2 text-uppercase fw-semibold">
                                    Add to Cart 
                                </button>
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </div>
       
       
        <div id="commentsContainer">
            @await Component.InvokeAsync("FeedBackPerProduct", new { productId = Model.ProductId })
        </div>


        @if (ViewBag.CanComment)
        {
            <div id="feedBackContainer" class="col-12 col-md-6 mt-3">
                <label for="feedbackInput" class="form-label ms-2 fw-bold">Leave Your Feedback</label>
                <div class="input-group">
                    <input type="text" id="feedbackInput" class="form-control" placeholder="Write a comment..." aria-label="Feedback">
                    <button class="btn btn-primary" type="button" id="sendFeedBack">
                        <i class="bi bi-send"></i> Send
                    </button>
                </div>
            </div>
        }
    </div>

</form>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {
        $("#likeBtn").click(function (e) {
            e.preventDefault();
            sendVote(0); 
        });
        $("#dislikeBtn").click(function (e) {
            e.preventDefault();
            sendVote(1); 
        });
        function sendVote(voteType) {
           
            $.ajax({
                url: "/Customer/Home/Vote",
                type: "POST",
                 headers: {
            "RequestVerificationToken":
                $('input[name="__RequestVerificationToken"]').val()
        },
                data: {
                    voteType: voteType,
                    productId: @Model.ProductId
                },
                success: function (res) {
                 const lBtn= $('#likeBtn');
                 const dBtn= $('#dislikeBtn');
                 const lCount= $('#likeCount');
                 const dCount= $('#disLikeCount');
                 let getVal=(el)=>parseInt(el.text())||0;
                 
                  if(res.data=='oUpVote'){
                      lBtn.addClass('active');
                      lCount.text(getVal(lCount)+1);
                    
                      if(dBtn.hasClass('active')){
                          dBtn.removeClass('active');
                          dCount.text(getVal(dCount)-1);
                      }
                  }
                  else if(res.data=='xUpVote'){
                       lBtn.removeClass('active');
                       lCount.text(getVal(lCount)-1);
                  }
                

                  if(res.data=='oDownVote'){
                      dBtn.addClass('active');
                      dCount.text(getVal(dCount)+1);

                      if(lBtn.hasClass('active')){
                          lBtn.removeClass('active');
                          lCount.text(getVal(lCount)-1);
                      }
                  }
                  else if(res.data=='xDownVote'){
                       dBtn.removeClass('active');
                       dCount.text(getVal(dCount)-1);
                  }

                },
                error: function () {
                    alert("An error occurred...");
                }
            });
        }

        $(document).on("click", "#sendFeedBack", function () {
            debugger;
            const feedback=$("#feedbackInput").val();
             $.ajax({
                url: "/Customer/Home/AddFeedBack",
                type: "POST",
                 headers: {
            "RequestVerificationToken":
                $('input[name="__RequestVerificationToken"]').val()
        },
                data: {
                    content:feedback,
                    productId: @Model.ProductId
                },

                success: function (res) {
                    if(res.status===true){

                   

                         $("#feedBackContainer").addClass("fade-out-fast")
                        $("#commentsContainer").load('@Url.Action("GetFeedBack", "Home", new { area = "Customer", productId = Model.ProductId })');
                    }
                    else{
                  toastr.error(`${res.message}`);

                    }
                },
                error: function () {
                  toastr.error("Something went wrong");
                }
            });

        });
    });


    document.addEventListener('itemDeleted',()=>{
        debugger
        
        document.querySelector('.card').insertAdjacentHTML("beforeend",`<div id="feedBackContainer" class="col-12 col-md-6 mt-3">
                <label for="feedbackInput" class="form-label ms-2 fw-bold">Leave Your Feedback</label>
                <div class="input-group">
                    <input type="text" id="feedbackInput" class="form-control" placeholder="Write a comment..." aria-label="Feedback">
                    <button class="btn btn-primary" type="button" id="sendFeedBack">
                        <i class="bi bi-send"></i> Send
                    </button>
                </div>
            </div>`);
    });



 
</script>