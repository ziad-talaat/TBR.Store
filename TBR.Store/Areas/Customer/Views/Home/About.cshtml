@{
    ViewData["Title"] = "About Us";
}


<section class="about-hero">
    <div class="container">
        <p class="about-hero-eyebrow">Our Story</p>
        <h1 class="about-hero-title">
            Born from a Love of<br><em>Good Books</em>
        </h1>
        <p class="about-hero-sub">
            TBR.Store is where your "To Be Read" list finally meets its match —
            a curated online bookstore built for readers who take their shelves seriously.
        </p>
        <div class="about-hero-divider">
            <span>📖</span>
        </div>
    </div>
</section>

<section class="about-stats">
    <div class="container">
        <div class="about-stats-grid">
            <div class="stat-item">
                <div class="stat-number">12K+</div>
                <div class="stat-label">Titles Available</div>
            </div>
            <div class="stat-item">
                <div class="stat-number">40K+</div>
                <div class="stat-label">Happy Readers</div>
            </div>
            <div class="stat-item">
                <div class="stat-number">98%</div>
                <div class="stat-label">Satisfaction Rate</div>
            </div>
            <div class="stat-item">
                <div class="stat-number">2021</div>
                <div class="stat-label">Founded</div>
            </div>
        </div>
    </div>
</section>

<hr class="tbr-sep" />

<section class="about-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 reveal">
                <p class="section-label">How it started</p>
                <h2 class="section-heading">Every great story<br>begins with a single page.</h2>
                <div class="section-body">
                    <p>
                        TBR.Store started in a small apartment surrounded by teetering stacks of paperbacks
                        and a spreadsheet that was getting dangerously out of hand. We couldn't find a bookstore
                        that felt like it truly understood readers — not just buyers.
                    </p>
                    <p>
                        So we built one. A place where discovery is as important as delivery, where every category
                        is curated with intention, and where your next favourite book is always just one scroll away.
                    </p>
                </div>
                <div class="pull-quote">
                    <p>"A reader lives a thousand lives before he dies. The man who never reads lives only one."</p>
                </div>
                <div class="section-body">
                    <p>
                        That quote by George R.R. Martin is pinned above our desks. It's the reason TBR.Store exists.
                    </p>
                </div>
            </div>
            <div class="col-lg-6 reveal" style="transition-delay:.15s">
                <div class="book-art">
                    <div class="spine" style="width:28px;height:210px;background:#8B4513;"><span style="color:#f5deb3;">Dune</span></div>
                    <div class="spine" style="width:22px;height:185px;background:#2c3e50;"><span style="color:#ecf0f1;">Kafka</span></div>
                    <div class="spine" style="width:32px;height:240px;background:#6b4226;"><span style="color:#fde8c8;">The Name of the Wind</span></div>
                    <div class="spine" style="width:20px;height:175px;background:#b8860b;"><span style="color:#1a1208;">Gatsby</span></div>
                    <div class="spine" style="width:26px;height:200px;background:#4a6741;"><span style="color:#e8f5e4;">Middlemarch</span></div>
                    <div class="spine" style="width:18px;height:160px;background:#c0392b;"><span style="color:#fdecea;">Lolita</span></div>
                    <div class="spine" style="width:30px;height:225px;background:#34495e;"><span style="color:#d5e8f5;">Crime & Pun.</span></div>
                    <div class="spine" style="width:24px;height:190px;background:#7d3c98;"><span style="color:#f5eef8;">1984</span></div>
                    <div class="spine" style="width:22px;height:170px;background:#d4a32a;"><span style="color:#1a1208;">Jane Eyre</span></div>
                    <div class="spine" style="width:28px;height:205px;background:#1a5276;"><span style="color:#d6eaf8;">Moby Dick</span></div>
                    <div class="spine" style="width:16px;height:150px;background:#922b21;"><span style="color:#fdedec;">Beloved</span></div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="ornament">✦ ✦ ✦</div>

<section class="about-section" style="background:var(--cream); padding: 5rem 0;">
    <div class="container">
        <div class="text-center reveal">
            <p class="section-label">What drives us</p>
            <h2 class="section-heading" style="margin-bottom:.5rem">Our Values</h2>
            <p style="font-family:'DM Sans',sans-serif;color:var(--text-muted);max-width:480px;margin:0 auto;line-height:1.7;font-size:.95rem;">
                Three principles that shape every decision we make, from how we curate titles to how we treat our customers.
            </p>
        </div>
        <div class="values-grid">
            <div class="value-card reveal" style="transition-delay:.1s">
                <span class="value-icon">📚</span>
                <div class="value-title">Curation Over Volume</div>
                <p class="value-desc">
                    We'd rather have 12,000 great books than 100,000 mediocre ones.
                    Every title in our catalogue is here for a reason.
                </p>
            </div>
            <div class="value-card reveal" style="transition-delay:.2s">
                <span class="value-icon">🤝</span>
                <div class="value-title">Reader First</div>
                <p class="value-desc">
                    We design every part of TBR.Store around the reader's experience —
                    not algorithms, not ads, not affiliates.
                </p>
            </div>
            <div class="value-card reveal" style="transition-delay:.3s">
                <span class="value-icon">🌍</span>
                <div class="value-title">Diverse Voices</div>
                <p class="value-desc">
                    Great literature comes from everywhere. We actively seek out
                    authors and stories that expand the conversation.
                </p>
            </div>
            <div class="value-card reveal" style="transition-delay:.4s">
                <span class="value-icon">⚡</span>
                <div class="value-title">Reliable Delivery</div>
                <p class="value-desc">
                    Books are time-sensitive joy. We partner with carriers
                    who treat your order with the same urgency you feel.
                </p>
            </div>
            <div class="value-card reveal" style="transition-delay:.5s">
                <span class="value-icon">💬</span>
                <div class="value-title">Honest Reviews</div>
                <p class="value-desc">
                    Every review on TBR.Store comes from verified purchases.
                    No fake stars, no suppressed criticism.
                </p>
            </div>
            <div class="value-card reveal" style="transition-delay:.6s">
                <span class="value-icon">♻️</span>
                <div class="value-title">Sustainable Reads</div>
                <p class="value-desc">
                    We offset our shipping carbon, use minimal packaging,
                    and support publishers with responsible printing practices.
                </p>
            </div>
        </div>
    </div>
</section>

<hr class="tbr-sep" />

<section class="about-section">
    <div class="container">
        <div class="text-center reveal">
            <p class="section-label">The people behind the shelves</p>
            <h2 class="section-heading">Meet the Team</h2>
        </div>
        <div class="team-grid">
            <div class="team-card reveal" style="transition-delay:.1s">
                <div class="team-avatar">Z</div>
                <div class="team-name">Zeyad Talaat</div>
                <div class="team-role">Founder & Developer</div>
            </div>
            <div class="team-card reveal" style="transition-delay:.2s">
                <div class="team-avatar">✦</div>
                <div class="team-name">The Curators</div>
                <div class="team-role">Editorial Team</div>
            </div>
            <div class="team-card reveal" style="transition-delay:.3s">
                <div class="team-avatar">❤</div>
                <div class="team-name">Our Community</div>
                <div class="team-role">40,000+ Readers</div>
            </div>
        </div>
    </div>
</section>

<div class="container">
    <div class="about-cta reveal">
        <h2>Your next favourite book<br><em>is already waiting.</em></h2>
        <p>Browse our full catalogue and find the story that was meant for you.</p>
        <a href="@(Context.Session.GetString("LastIndexUrl") ?? Url.Action("Index", "Home"))" class="tbr-btn-gold">
            <i class="bi bi-book"></i> Browse the Store
        </a>
    </div>
</div>

<script>
    const revealEls = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver(entries => {
        entries.forEach(e => {
            if (e.isIntersecting) {
                e.target.classList.add('visible');
                observer.unobserve(e.target);
            }
        });
    }, { threshold: 0.12 });
    revealEls.forEach(el => observer.observe(el));
</script>
